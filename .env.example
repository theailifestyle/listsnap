# Copy to .env (never commit .env). Leave the key empty for offline mode:
# typed lists are split line by line and photos are stored but not read.
OPENROUTER_API_KEY=
# Any vision-capable model on OpenRouter.
AI_MODEL=openai/gpt-4o-mini
# Optional: another OpenAI-compatible API instead of OpenRouter.
# AI_BASE_URL=https://api.openai.com/v1
